# ─── SentinelWatch Configuration ─────────────────────────────────────
#
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
#
# COST SUMMARY:
#   News APIs:     $0 (all free tiers)
#   Email:         $0 (Brevo/SendPulse free tier)
#   Claude API:    ~$5-10/month (Haiku 4.5)
#   Hosting:       $0 (Railway/Render free tier)

# ─── News APIs (stack ALL for 400+ req/day free) ────────────────────

# NewsAPI.org — 100 req/day free
# Sign up: https://newsapi.org
REACT_APP_NEWSAPI_KEY=

# GNews — 100 req/day free
# Sign up: https://gnews.io
REACT_APP_GNEWS_KEY=

# NewsData.io — 200 credits/day free
# Sign up: https://newsdata.io
REACT_APP_NEWSDATA_KEY=

# Google News RSS — unlimited, no key needed (auto-enabled)

# ─── Server-side keys (Vercel deployment) ───────────────────────────
#
# In production the browser never calls the providers directly — it goes
# through /api/news/*, which read these UNPREFIXED variables. Set them in
# the Vercel project's Environment Variables, not in this file.
#
# If one is missing, the app now says so explicitly: the provider shows
# "No key configured on the server" in the API Quota panel and is skipped
# instead of being retried on every poll.
#
#   NEWSAPI_KEY     — same value as REACT_APP_NEWSAPI_KEY
#   GNEWS_KEY       — same value as REACT_APP_GNEWS_KEY
#   NEWSDATA_KEY    — same value as REACT_APP_NEWSDATA_KEY

# ─── Claude API (geo-scoring + daily briefings) ─────────────────────
# ~$5-10/month on Haiku 4.5
# Sign up: https://console.anthropic.com
REACT_APP_ANTHROPIC_API_KEY=

# ─── Backend Proxy URL ──────────────────────────────────────────────
# Points to your /server deployment (Railway, Render, etc.)
# Handles: CORS proxy for news APIs, Claude API calls, email sending
REACT_APP_PROXY_URL=http://localhost:3001

# ─── Email Notifications (configured in /server/.env) ───────────────
# Choose one — all have free tiers, no credit card required:
#   Brevo:     300 emails/day free  — https://www.brevo.com
#   SendPulse: 12,000/month free    — https://sendpulse.com
#   Maileroo:  3,000/month free     — https://maileroo.com
# (Set the actual API keys in /server/.env, not here)
